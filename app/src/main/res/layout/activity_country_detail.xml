<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".presentation.ui.country.CountryDetailActivity">

    <!-- Bandera grande arriba -->
    <ImageView
        android:id="@+id/iv_flag"
        android:layout_width="240dp"
        android:layout_height="144dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/flag_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"
        tools:src="@drawable/ic_launcher_foreground" />

    <!-- Nombre del país grande y centrado -->
    <TextView
        android:id="@+id/tv_country_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/iv_flag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Argentina" />

    <!-- ScrollView con los detalles -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_country_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Capital -->
            <TextView
                android:id="@+id/tv_capital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"
                tools:text="Capital: Buenos Aires" />

            <!-- Population -->
            <TextView
                android:id="@+id/tv_population"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"
                tools:text="Population: 47,315,966" />

            <!-- Area -->
            <TextView
                android:id="@+id/tv_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"
                tools:text="Area: 2,780,400 km²" />

            <!-- Region -->
            <TextView
                android:id="@+id/tv_region"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"
                tools:text="Region: Americas" />

            <!-- Subregion -->
            <TextView
                android:id="@+id/tv_subregion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#333333"
                tools:text="Sub-region: South America" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>